# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://reviewarmour:localdev@localhost:5432/reviewarmour

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_US_PHONE=+1786...
TWILIO_CA_PHONE=+1416...

# Twilio (WhatsApp) — leave blank to disable WhatsApp channel
TWILIO_WA_US_PHONE=whatsapp:+1786...
TWILIO_WA_CA_PHONE=whatsapp:+1416...

# Amazon SES
SES_REGION=us-east-1
SES_SENDER_EMAIL_US=hello@reviewarmour.com
SES_SENDER_EMAIL_CA=hello@reviewarmour.ca
SES_SENDER_NAME=ReviewArmour

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_INVOICE_CHANNEL=C0...
SLACK_STALL_CHANNEL=C0...
SLACK_SALESMAN_CHANNEL=C0...

# Operations
JAYDEN_PHONE=+1786...
JAYDEN_SLACK_ID=U0...
SALESMEN_ON_DUTY=jayden
OPS_TIMEZONE=America/New_York
BIZ_HOURS_START=8
BIZ_HOURS_END=19
STALL_WINDOW_HOURS=6
MAX_AI_FOLLOWUPS=3

# Feature flags
AI_QUOTE_ALLOWED=true
SOFT_QUOTE_MODE=false

# GBP scraper (Patchright auth state — copy patchright_maps_auth.json to project root)
GBP_AUTH_STATE=patchright_maps_auth.json

# Webhook security
WEBHOOK_SECRET=...
